# ---------------------------------------------------------------------------
# Secrets template for cloud persistence (Google Sheets).
#
# DO NOT commit a filled-in version of this file. Instead:
#   * Locally: copy to ".streamlit/secrets.toml" and fill it in (git-ignored).
#   * On Streamlit Community Cloud: paste the filled-in contents into
#     App -> Settings -> Secrets.
#
# Leaving these out is fine — the app then uses the local file backend.
# See README.md ("Deploy as a private cloud web app") for the full walkthrough.
# ---------------------------------------------------------------------------

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Keep the literal \n sequences — do not turn them into real line breaks.
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...your...key...\n-----END PRIVATE KEY-----\n"
client_email = "tracker-bot@your-project-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/tracker-bot%40your-project-id.iam.gserviceaccount.com"

[sheets]
# The long ID in your sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
spreadsheet_key = "your-google-sheet-id"
